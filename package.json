{
  "name": "los-cerdas-direccion-artistica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:offline": "node scripts/build-offline.mjs",
    "package:prototype": "npm run build && npm run build:offline && python3 scripts/package_prototype.py",
    "audit:media": "python3 scripts/audit_media.py",
    "prepare:photos": "python3 scripts/prepare_photos.py",
    "verify:originals": "python3 scripts/verify_originals.py",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
